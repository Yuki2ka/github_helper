# Timestamp regular expressions.
LRC_RE = re.compile(r"^\[(\d{1,3}):(\d{2})(?:\.(\d{1,3}))?\]\s*(.*)$")
SRT_TIME_RE = re.compile(r"(\d{1,3}):(\d{2}):(\d{2})[.,](\d{1,3})")

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def fmt_time(seconds):
    """Format seconds as mm:ss.cs (or hh:mm:ss.cs when over an hour).

    Works on whole milliseconds so the hundredths digit never rolls over to 100.
    """
    seconds = max(0.0, float(seconds))
    total_ms = int(round(seconds * 1000))
    hours, remainder = divmod(total_ms, 3_600_000)
    minutes, remainder = divmod(remainder, 60_000)
    secs, ms = divmod(remainder, 1000)
    hundredths = ms // 10
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}.{hundredths:02d}"
    return f"{minutes:02d}:{secs:02d}.{hundredths:02d}"


def parse_time_part(h, m, s, ms):
    # ms is a string from the regex groups; str() keeps it safe for other callers.
    return int(h) * 3600 + int(m) * 60 + int(s) + (int(ms) / 10 ** len(str(ms)) if ms else 0.0)


