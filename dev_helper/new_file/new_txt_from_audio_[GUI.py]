# ---------------------------------------------------------------------------
# Transcript parsing
# ---------------------------------------------------------------------------


def _parse_lrc(lines):
    entries = []
    for line in lines:
        match = LRC_RE.match(line.strip("\n"))
        if not match:
            continue
        mm, ss, ms, text = match.groups()
        entries.append({
            "start": parse_time_part(0, mm, ss, ms),
            "end": None,
            "text": text,
        })
    return entries


def _parse_srt(lines):
    entries = []
    index = 0
    while index < len(lines):
        match = SRT_TIME_RE.search(lines[index])
        if not match and "-->" not in lines[index]:
            index += 1
            continue
        if not match:
            index += 1
            continue
        parts = lines[index].split("-->")
        start = parse_time_part(*SRT_TIME_RE.search(parts[0]).groups())
        end_match = SRT_TIME_RE.search(parts[1])
        end = parse_time_part(*end_match.groups()) if end_match else None
        collected = []
        index += 1
        while index < len(lines) and lines[index].strip():
            collected.append(lines[index])
            index += 1
        entries.append({
            "start": start,
            "end": end,
            "text": " ".join(collected).strip(),
        })
    return entries


def _parse_json(data):
    if isinstance(data, dict):
        segments = data.get("segments", data if isinstance(data, list) else [])
    elif isinstance(data, list):
        segments = data
    else:
        segments = []
    entries = []
    for segment in segments:
        if not isinstance(segment, dict):
            continue
        start = segment.get("start", segment.get("t", segment.get("begin", 0)))
        text = segment.get("text", segment.get("txt", segment.get("content", "")))
        end = segment.get("end", segment.get("to", segment.get("end")))
        entries.append({
            "start": float(start or 0),
            "end": float(end) if end is not None else None,
            "text": str(text),
        })
    return entries


def parse_transcript(path):
    """Parse a transcript file into a list of {start, end, text} entries.

    Recognizes LRC, SRT, JSON and plain text automatically.
    """
    path = Path(path)
    content = path.read_text(encoding="utf-8", errors="replace")
    lines = content.splitlines()

    first = ""
    for line in lines:
        if line.strip():
            first = line
            break

    # LRC files often start with header tags ([ti:], [ar:], ...), so detect
    # the format by any timestamped line, not only the first one.
    if any(LRC_RE.match(line) for line in lines):
        entries = _parse_lrc(lines)
    elif "-->" in content and SRT_TIME_RE.search(content):
        entries = _parse_srt(lines)
    elif path.suffix.lower() == ".json" or content.lstrip().startswith(("{", "[")):
        entries = _parse_json(json.loads(content))
    else:
        entries = [{"start": 0.0, "end": None, "text": content}]

    entries = [e for e in entries if str(e.get("text", "")).strip() or e["start"] > 0]
    entries.sort(key=lambda e: e["start"])
    if not entries:
        entries = [{"start": 0.0, "end": None, "text": content}]
    return entries


# ---------------------------------------------------------------------------
# Audio playback (optional pygame backend)
# ---------------------------------------------------------------------------


class AudioPlayer:
    """Very small wrapper around pygame.mixer music playback.

    All methods are safe to call when no backend is available; they
    simply do nothing and report False / zero values.
    """

    def __init__(self, log):
        self.log = log
        self.backend = None
        self._pg = None
        self.path = None
        self.duration = 0.0
        self._offset = 0.0
        self._play_start = 0.0
        self._playing = False
        self._paused = False
        self._paused_pos = 0.0

    def available(self):
        return self.backend == "pygame"

    def init_backend(self):
        """Import and initialize pygame.mixer. Returns True on success."""
        if self.available():
            return True
        try:
            import pygame as pg
        except Exception as error:
            self.log(f"pygame is not installed: {error}")
            return False
        try:
            pg.mixer.init()
        except Exception as error:
            self.log(f"pygame mixer init failed: {error}")
            try:
                pg.init()
                pg.mixer.init()
            except Exception as error2:
                self.log(f"pygame mixer could not start: {error2}")
                return False
        self._pg = pg
        self.backend = "pygame"
        self.log("Audio backend ready: pygame")
        return True

    def load(self, path):
        """Load an audio file. Returns True on success."""
        self.stop()
        self.path = Path(path)
        if not self.available():
            self.log("No audio backend - file opened without playback")
            return True
        try:
            sound = self._pg.mixer.Sound(str(self.path))
            self.duration = float(sound.get_length() or 0.0)
        except Exception as error:
            self.duration = 0.0
            self.log(f"Could not read audio duration: {error}")
        try:
            self._pg.mixer.music.load(str(self.path))
        except Exception as error:
            self.log(f"Failed to load audio: {error}")
            return False
        self.log(f"Loaded audio: {self.path.name} ({fmt_time(self.duration)})")
        return True

    def _current_position(self):
        if self._paused:
            return self._paused_pos
        if self._playing and self._pg is not None:
            pos_ms = self._pg.mixer.music.get_pos()
            if pos_ms < 0:
                # Music reached the end of the file.
                return self.duration if self.duration else self._offset
            return self._offset + pos_ms / 1000.0
        return 0.0

    def play(self, start=0.0):
        if not self.available():
            return False
        start = max(0.0, float(start))
        self._pg.mixer.music.play(loops=0, start=start)
        self._offset = start
        self._play_start = time.monotonic()
        self._playing = True
        self._paused = False
        return True

    def pause(self):
        if self._playing and not self._paused and self._pg is not None:
            self._paused_pos = self._current_position()
            self._pg.mixer.music.pause()
            self._playing = False
            self._paused = True

    def resume(self):
        if self._paused and self._pg is not None:
            self._pg.mixer.music.unpause()
            self._play_start = time.monotonic()
            self._playing = True
            self._paused = False

    def stop(self):
        if self._pg is not None:
            try:
                self._pg.mixer.music.stop()
            except Exception:
                pass
        self._playing = False
        self._paused = False
        self._offset = 0.0
        self._play_start = 0.0
        self._paused_pos = 0.0

    def seek(self, seconds):
        seconds = max(0.0, float(seconds))
        if self.duration and seconds > self.duration:
            seconds = self.duration
        self._offset = seconds
        if self._playing and self._pg is not None:
            self._pg.mixer.music.play(loops=0, start=seconds)
            self._play_start = time.monotonic()
        return seconds

    def set_volume(self, volume):
        if self._pg is not None:
            try:
                self._pg.mixer.music.set_volume(max(0.0, min(1.0, float(volume))))
            except Exception:
                pass

    def is_playing(self):
        return self._playing

    def position(self):
        return self._current_position()


# ---------------------------------------------------------------------------
# Pip helper for optional portable dependencies
# ---------------------------------------------------------------------------


def pip_install(packages, log):
    """Install packages into ./libs beside the script (portable)."""
    LIBS_DIR.mkdir(parents=True, exist_ok=True)
    command = [
        sys.executable, "-m", "pip", "install", "--no-compile",
        "--quiet", "--target", str(LIBS_DIR),
    ] + list(packages)
    log("Installing " + ", ".join(packages) + " into ./libs ...")
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=300)
    except Exception as error:
        return False, str(error)
    output = (result.stdout or "") + (result.stderr or "")
    if result.returncode != 0:
        log(output[-2000:])
        return False, output
    log("Installation finished.")
    return True, output


