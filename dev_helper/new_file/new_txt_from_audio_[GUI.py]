    def _build_status(self):
        self.status_var = tk.StringVar(value="Ready")
        status = ttk.Label(self.root, textvariable=self.status_var, anchor="w")
        status.grid(row=4, column=0, sticky="ew")

    # ------------------------------------------------------------------
    # Shortcuts
    # ------------------------------------------------------------------
    def _bind_shortcuts(self):
        root = self.root
        root.bind_all("<Control-o>", lambda e: (self._open_audio(), "break")[1])
        root.bind_all("<Control-t>", lambda e: (self._open_transcript(), "break")[1])
        root.bind_all("<Control-s>", lambda e: (self._save_transcript(), "break")[1])
        root.bind_all("<Control-f>", lambda e: (self._focus_search(), "break")[1])
        root.bind_all("<F3>", lambda e: (self._jump_match(1), "break")[1])
        root.bind_all("<Shift-F3>", lambda e: (self._jump_match(-1), "break")[1])
        root.bind_all("<Escape>", self._on_escape)
        root.bind_all("<KeyPress-space>", self._on_space)
        root.bind_all("<KeyPress-s>", self._on_stop_key)

    def _typing_widget(self, widget):
        return widget.winfo_class() in ("Entry", "Text")

    def _on_space(self, event):
        if self._typing_widget(event.widget):
            return
        self._toggle_play()
        return "break"

    def _on_stop_key(self, event):
        if self._typing_widget(event.widget):
            return
        self._stop()
        return "break"

    def _on_escape(self, event):
        if self._typing_widget(event.widget):
            return
        self._clear_search()
        return "break"

    def _focus_search(self):
        self.search_entry.focus_set()
        self.search_entry.selection_range(0, tk.END)

    # ------------------------------------------------------------------
    # Logging / status / theme
    # ------------------------------------------------------------------
    def log(self, message):
        print(message)
        self.log_text.configure(state=tk.NORMAL)
        self.log_text.insert(tk.END, message + "\n")
        self.log_text.see(tk.END)
        self.log_text.configure(state=tk.DISABLED)
        self.root.update_idletasks()

    def set_status(self, message, temporary=False):
        self.status_var.set(message)
        if temporary:
            self.root.after(4000, lambda: self.status_var.set("Ready"))

    def _toggle_theme(self):
        self.dark = not self.dark
        self._apply_theme()
        self.btn_theme.configure(text="\U0001F311 Light mode" if self.dark
                                 else "\U0001F311 Dark mode")

    def _apply_theme(self):
        if self.dark:
            palette = {
                "bg": "#2d2d2d", "fg": "#e6e6e6", "insert": "#ffffff",
                "select": "#3a6ea5", "current": "#5c4a00", "current_fg": "#ffe066",
                "match": "#8a5a00", "match_fg": "#ffe066",
                "toolbar": "#3a3a3a", "status": "#3a3a3a",
            }
        else:
            palette = {
                "bg": "#ffffff", "fg": "#1a1a1a", "insert": "#000000",
                "select": "#b3d7ff", "current": "#fff37c", "current_fg": "#1a1a1a",
                "match": "#ffd966", "match_fg": "#1a1a1a",
                "toolbar": "#f2f2f2", "status": "#e5e5e5",
            }

        self.root.configure(bg=palette["bg"])
        self.text.configure(bg=palette["bg"], fg=palette["fg"],
                            insertbackground=palette["insert"],
                            selectbackground=palette["select"])
        self.text.tag_configure("current", background=palette["current"],
                                foreground=palette["current_fg"])
        self.text.tag_configure("match", background=palette["match"],
                                foreground=palette["match_fg"])

        style = ttk.Style()
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure("TFrame", background=palette["toolbar"])
        style.configure("TLabel", background=palette["status"], foreground=palette["fg"])
        style.configure("TEntry", fieldbackground=palette["bg"], foreground=palette["fg"])

    def _toggle_log(self):
        if self.log_frame.winfo_viewable():
            self.log_frame.grid_remove()
        else:
            self.log_frame.grid()

    # ------------------------------------------------------------------
    # File operations
    # ------------------------------------------------------------------
    def _open_audio(self):
        path = filedialog.askopenfilename(
            title="Open audio file", initialdir=self.last_dir,
            filetypes=audio_filetypes())
        if not path:
            return
        self.last_dir = os.path.dirname(path)
        ok = self.player.load(path)
        if not ok:
            messagebox.showerror(APP_TITLE, f"Could not load audio file:\n{path}")
            return
        self.audio_path = path
        self.player.stop()
        self._set_seek_limits(self.player.duration)
        self.seek_scale.set(0)
        self.time_var.set(f"00:00.00 / {fmt_time(self.player.duration)}")
        self.btn_play.configure(state=tk.NORMAL)
        self.btn_stop.configure(state=tk.NORMAL)
        self.btn_save.configure(state=tk.NORMAL)
        self.btn_install.pack_forget()
        self._update_title()
        self.set_status(f"Audio loaded: {os.path.basename(path)}")

    def _open_transcript(self):
        path = filedialog.askopenfilename(
            title="Open transcript", initialdir=self.last_dir,
            filetypes=text_filetypes())
        if not path:
            return
        self.last_dir = os.path.dirname(path)
        try:
            self.entries = parse_transcript(path)
        except Exception as error:
            messagebox.showerror(APP_TITLE, f"Could not parse transcript:\n{error}")
            return
        self.text_path = path
        self._fill_text()
        self._clear_search()
        self._update_title()
        self.set_status(
            f"Transcript loaded: {os.path.basename(path)} ({len(self.entries)} lines)")

    def _fill_text(self):
        self.text.configure(state=tk.NORMAL)
        self.text.delete("1.0", tk.END)
        for index, entry in enumerate(self.entries, start=1):
            line_text = str(entry.get("text", "")).replace("\n", " ")
            self.text.insert(f"{index}.0", line_text + "\n")
        self.text.configure(state=tk.DISABLED)
        self.current_line = -1
        self.text.tag_remove("current", "1.0", tk.END)

    def _save_transcript(self):
        if not self.entries:
            messagebox.showinfo(APP_TITLE, "No transcript to save.")
            return
        path = filedialog.asksaveasfilename(
            title="Save transcript", initialdir=self.last_dir,
            defaultextension=".txt", filetypes=text_filetypes())
        if not path:
            return
        self.last_dir = os.path.dirname(path)
        try:
            with open(path, "w", encoding="utf-8") as handle:
                for entry in self.entries:
                    handle.write(str(entry.get("text", "")) + "\n")
            self.set_status(f"Transcript saved: {os.path.basename(path)}")
        except Exception as error:
            messagebox.showerror(APP_TITLE, f"Could not save transcript:\n{error}")

    def _export_lrc(self):
        if not self.entries:
            messagebox.showinfo(APP_TITLE, "No transcript to export.")
            return
        path = filedialog.asksaveasfilename(
            title="Export LRC", initialdir=self.last_dir,
            defaultextension=".lrc", filetypes=[("LRC lyrics", "*.lrc"),
                                                ("All files", "*.*")])
        if not path:
            return
        self.last_dir = os.path.dirname(path)
        try:
            with open(path, "w", encoding="utf-8") as handle:
                for entry in self.entries:
                    handle.write(f"{fmt_time(entry['start'])} {entry['text']}\n")
            self.set_status(f"LRC exported: {os.path.basename(path)}")
        except Exception as error:
            messagebox.showerror(APP_TITLE, f"Could not export LRC:\n{error}")

    def _reload_audio(self):
        if not self.audio_path:
            return
        self._open_audio_file(self.audio_path)

    def _open_audio_file(self, path):
        ok = self.player.load(path)
        if ok:
            self.audio_path = path
            self._set_seek_limits(self.player.duration)
            self.seek_scale.set(0)
            self.time_var.set(f"00:00.00 / {fmt_time(self.player.duration)}")
            self.btn_play.configure(state=tk.NORMAL)
            self.btn_stop.configure(state=tk.NORMAL)
            self.btn_save.configure(state=tk.NORMAL)
            self._update_title()

    def _set_seek_limits(self, duration):
        top = max(duration, 1.0)
        self.seek_scale.configure(from_=0, to=top, resolution=0.1)

    # ------------------------------------------------------------------
    # Playback
    # ------------------------------------------------------------------
    def _toggle_play(self):
        if not self.audio_path:
            messagebox.showinfo(APP_TITLE, "Open an audio file first.")
            return
        if not self.player.available():
            if not self._install_backend_prompt():
                return
            if not self.player.available():
                messagebox.showerror(APP_TITLE, "Audio backend unavailable.")
                return
        if self.player.is_playing():
            self.player.pause()
            self.btn_play.configure(text="\u25B6 Play")
        elif self.player._paused:
            self.player.resume()
            self.btn_play.configure(text="\u23F8 Pause")
        else:
            start = float(self.seek_scale.get() or 0)
            self.player.play(start=start)
            self.btn_play.configure(text="\u23F8 Pause")
        self.btn_stop.configure(state=tk.NORMAL)

    def _stop(self):
        self.player.stop()
        self.btn_play.configure(text="\u25B6 Play")
        self.btn_stop.configure(state=tk.DISABLED)
        self.seek_scale.set(0)
        self.time_var.set(f"00:00.00 / {fmt_time(self.player.duration)}")
        self.text.tag_remove("current", "1.0", tk.END)
        self.current_line = -1

    def _tick(self):
        self._after_id = self.root.after(200, self._tick)
        if not self.player.is_playing():
            return
        pos = self.player.position()
        if self.player.duration and pos >= self.player.duration - 0.3:
            self._stop()
            self.time_var.set(f"{fmt_time(self.player.duration)} / "
                              f"{fmt_time(self.player.duration)}")
            return
        self._sync_to_position(pos)
        if not self._seeking:
            self.seek_scale.set(pos)
        self.time_var.set(f"{fmt_time(pos)} / {fmt_time(self.player.duration)}")

    def _sync_to_position(self, pos):
        target = -1
        for index, entry in enumerate(self.entries):
            if entry["start"] <= pos + 0.05:
                target = index
            else:
                break
        if target < 0 or target == self.current_line:
            return
        self.text.tag_remove("current", "1.0", tk.END)
        self.current_line = target
        start_index = f"{target + 1}.0"
        if target + 1 < len(self.entries):
            end_index = f"{target + 2}.0"
        else:
            end_index = tk.END
        self.text.tag_add("current", start_index, end_index)
        self.text.see(start_index)

    def _seek_to(self, seconds, highlight_line=None):
        seconds = self.player.seek(seconds)
        self.seek_scale.set(seconds)
        self.time_var.set(f"{fmt_time(seconds)} / {fmt_time(self.player.duration)}")
        self.set_status(f"Seeked to {fmt_time(seconds)}")
        if highlight_line is not None:
            self._set_highlight_line(highlight_line - 1)
        elif self.entries:
            self._sync_to_position(seconds)

    def _set_highlight_line(self, line):
        if line == self.current_line:
            return
        self.text.tag_remove("current", "1.0", tk.END)
        self.current_line = line
        if line >= 0:
            start_index = f"{line + 1}.0"
            if line + 1 < len(self.entries):
                end_index = f"{line + 2}.0"
            else:
                end_index = tk.END
            self.text.tag_add("current", start_index, end_index)
            self.text.see(start_index)

    def _current_seek_seconds(self):
        try:
            return float(self.seek_scale.get() or 0)
        except tk.TclError:
            return 0.0

    # ------------------------------------------------------------------
    # Text interaction: ctrl-click / double-click / context menu
    # ------------------------------------------------------------------
    def _line_at(self, x, y):
        try:
            index = self.text.index(f"@{x},{y}")
        except tk.TclError:
            return -1
        try:
            return int(str(index).split(".")[0]) - 1
        except (ValueError, IndexError):
            return -1

    def _on_ctrl_click(self, event):
        line = self._line_at(event.x, event.y)
        if line < 0 or line >= len(self.entries):
            return
        seconds = self.entries[line]["start"]
        self._seek_to(seconds, highlight_line=line + 1)
        return "break"

    def _on_double_click(self, event):
        line = self._line_at(event.x, event.y)
        if line < 0 or line >= len(self.entries):
            return
        seconds = self.entries[line]["start"]
        self._seek_to(seconds, highlight_line=line + 1)
        return "break"

    def _on_context_menu(self, event):
        line = self._line_at(event.x, event.y)
        menu = tk.Menu(self.root, tearoff=False)
        if 0 <= line < len(self.entries):
            seconds = self.entries[line]["start"]
            menu.add_command(
                label=f"Seek to line {line + 1} ({fmt_time(seconds)})",
                command=lambda: self._seek_to(seconds, highlight_line=line + 1))
            menu.add_command(
                label="Copy line",
                command=lambda: self._copy_text(self.entries[line]["text"]))
        menu.add_separator()
        menu.add_command(label="Copy transcript",
                         command=lambda: self._copy_text("\n".join(
                             str(e.get("text", "")) for e in self.entries)))
        menu.add_command(label="Clear highlighting",
                         command=lambda: self.text.tag_remove("sel", "1.0", tk.END))
        try:
            menu.tk_popup(event.x_root, event.y_root)
        finally:
            menu.grab_release()

    def _on_copy(self, event):
        try:
            selection = self.text.selection_get()
        except tk.TclError:
            selection = None
        if selection:
            self._copy_text(selection)
        else:
            self._copy_text("\n".join(str(e.get("text", "")) for e in self.entries))
        return "break"

    def _copy_text(self, text_value):
        self.root.clipboard_clear()
        self.root.clipboard_append(text_value)
        self.set_status("Copied to clipboard")

    # ------------------------------------------------------------------
    # Seek scale / jump to time
    # ------------------------------------------------------------------
    def _on_seek_drag(self, event):
        self._seeking = True
        try:
            value = float(self.seek_scale.get())
        except tk.TclError:
            return
        total = self.player.duration or 0.0
        self.time_var.set(f"{fmt_time(value)} / {fmt_time(total)}")

    def _on_seek_release(self, event):
        self._seeking = False
        try:
            value = float(self.seek_scale.get())
        except tk.TclError:
            return
        if self.audio_path and not self.player.available():
            self.set_status(f"Position {fmt_time(value)} (no audio backend)")
            return
        self._seek_to(value)

    def _on_volume(self, value):
        self.player.set_volume(float(value) / 100.0)

    def _jump_to_time(self):
        text_value = self.jump_entry.get().strip()
        if not text_value:
            return
        match = re.fullmatch(r"(\d+):(\d{2})(?:\.(\d{1,3}))?", text_value)
        if not match:
            messagebox.showerror(APP_TITLE, "Use mm:ss or mm:ss.cs")
            return
        seconds = parse_time_part(*match.groups())
        self._seek_to(seconds)
        self.jump_entry.focus_set()

    # ------------------------------------------------------------------
    # Search
    # ------------------------------------------------------------------
    def _do_search(self):
        term = self.search_var.get()
        self.text.tag_remove("match", "1.0", tk.END)
        self.text.tag_remove("sel", "1.0", tk.END)
        self.matches = []
        self.match_pos = -1
        if not term:
            self.set_status("Search cleared")
            return
        start = "1.0"
        while True:
            index = self.text.search(term, start, stopindex=tk.END, nocase=True)
            if not index:
                break
            end = f"{index}+{len(term)}c"
            self.text.tag_add("match", index, end)
            self.matches.append(index)
            start = end
        self.set_status(f"{len(self.matches)} match(es) found")
        if self.matches:
            self._jump_match(0)

    def _jump_match(self, direction):
        if not self.matches:
            return
        self.match_pos = (self.match_pos + direction) % len(self.matches)
        index = self.matches[self.match_pos]
        term = self.search_var.get()
        end = f"{index}+{len(term)}c"
        self.text.see(index)
        self.text.mark_set("insert", index)
        self.text.tag_add("sel", index, end)
        line = int(str(index).split(".")[0]) - 1
        if 0 <= line < len(self.entries):
            self._seek_to(self.entries[line]["start"], highlight_line=line + 1)

    def _clear_search(self):
        self.text.tag_remove("match", "1.0", tk.END)
        self.text.tag_remove("sel", "1.0", tk.END)
        self.matches = []
        self.match_pos = -1
        self.search_var.set("")
        self.search_entry.focus_set()
        self.set_status("Search cleared")

    # ------------------------------------------------------------------
    # Audio backend installation (optional, portable)
    # ------------------------------------------------------------------
    def _install_backend_prompt(self):
        if self.player.available():
            return True
        answer = messagebox.askyesno(
            APP_TITLE,
            "pygame is not installed, so audio playback is unavailable.\n\n"
            "Install it into the ./libs folder beside this script?\n"
            "(Requires an internet connection; nothing is installed "
            "into the operating system.)")
        if not answer:
            return False
        ok, _ = pip_install(OPTIONAL_PACKAGES[:1], self.log)
        if ok:
            importlib.invalidate_caches()
            if self.player.init_backend():
                self.btn_install.pack_forget()
                self.btn_play.configure(state=tk.NORMAL if self.audio_path
                                        else tk.DISABLED)
                return True
        return False

    # ------------------------------------------------------------------
    # Misc
    # ------------------------------------------------------------------
    def _update_title(self):
        parts = [APP_TITLE]
        if self.audio_path:
            parts.append(os.path.basename(self.audio_path))
        if self.text_path:
            parts.append("|")
            parts.append(os.path.basename(self.text_path))
        self.root.title(" ".join(parts))

    def _show_about(self):
        backend = "pygame" if self.player.available() else "none (read-only)"
        messagebox.showinfo(
            APP_TITLE,
            f"{APP_TITLE}\n"
            f"Portable Tkinter helper for synced transcript playback.\n\n"
            f"Audio backend: {backend}\n"
            f"Supported audio: {', '.join(AUDIO_EXTENSIONS)}\n"
            f"Supported text: {', '.join(TEXT_EXTENSIONS)}\n\n"
            f"Folder: {APP_DIR}")

    def _on_close(self):
        if self._after_id is not None:
            try:
                self.root.after_cancel(self._after_id)
            except tk.TclError:
                pass
        self.player.stop()
        self.root.destroy()


def main():
    try:
        from tkinterdnd2 import Tk as DnDTk
        root = DnDTk()
    except Exception:
        root = tk.Tk()

    app = App(root)

    # Optional drag & drop of audio/text files onto the window.
    try:
        from tkinterdnd2 import DND_FILES
        def _on_drop(event):
            data = event.data.strip()
            paths = []
            if data.startswith("{"):
                for chunk in data[1:].split("}"):
                    chunk = chunk.strip()
                    if chunk:
                        paths.append(chunk)
            else:
                paths = data.split()
            for path in paths:
                path = path.strip("{}")
                if not os.path.exists(path):
                    continue
                ext = os.path.splitext(path)[1].lower()
                if ext in AUDIO_EXTENSIONS and not app.audio_path:
                    app._open_audio_file(path)
                    break
            for path in paths:
                path = path.strip("{}")
                if not os.path.exists(path):
                    continue
                ext = os.path.splitext(path)[1].lower()
                if ext in TEXT_EXTENSIONS:
                    app._open_transcript_file(path)
                    break

        def _open_transcript_file(path):
            try:
                app.entries = parse_transcript(path)
            except Exception as error:
                app.log(f"Dropped transcript failed to parse: {error}")
                return
            app.text_path = path
            app._fill_text()
            app._clear_search()
            app._update_title()
            app.set_status(f"Dropped transcript: {os.path.basename(path)}")

        app._open_transcript_file = _open_transcript_file
        root.drop_target_register(DND_FILES)
        root.dnd_bind("<<Drop>>", _on_drop)
    except Exception:
        pass

    root.mainloop()


if __name__ == "__main__":
    main()
