class App:
    def __init__(self, root):
        self.root = root
        self.root.title(APP_TITLE)
        self.root.minsize(700, 460)

        self.player = AudioPlayer(self.log)
        self.entries = []            # list of {start, end, text}
        self.audio_path = None
        self.text_path = None
        self.current_line = -1       # highlighted transcript line (0-based)
        self.matches = []            # search match text indices
        self.match_pos = -1
        self._after_id = None
        self._seeking = False        # user is dragging the seek scale
        self._ignore_modified = False
        self.dark = False
        self.last_dir = str(APP_DIR)

        self._build_ui()
        self._bind_shortcuts()
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)
        self._tick()
        self.log(f"{APP_TITLE} ready. Open an audio file and a transcript.")

    # ------------------------------------------------------------------
    # UI construction
    # ------------------------------------------------------------------
    def _build_ui(self):
        root = self.root
        root.columnconfigure(0, weight=1)
        root.rowconfigure(1, weight=1)

        self._build_menu()
        self._build_toolbar()
        self._build_text_area()
        self._build_controls()
        self._build_log()
        self._build_status()

    def _build_menu(self):
        menu = tk.Menu(self.root)

        file_menu = tk.Menu(menu, tearoff=False)
        file_menu.add_command(label="Open audio...", accelerator="Ctrl+O",
                              command=self._open_audio)
        file_menu.add_command(label="Open transcript...", accelerator="Ctrl+T",
                              command=self._open_transcript)
        file_menu.add_separator()
        file_menu.add_command(label="Save transcript...", accelerator="Ctrl+S",
                              command=self._save_transcript)
        file_menu.add_command(label="Export as LRC...", command=self._export_lrc)
        file_menu.add_separator()
        file_menu.add_command(label="Exit", command=self._on_close)
        menu.add_cascade(label="File", menu=file_menu)

        play_menu = tk.Menu(menu, tearoff=False)
        play_menu.add_command(label="Play / Pause", accelerator="Space",
                              command=self._toggle_play)
        play_menu.add_command(label="Stop", command=self._stop)
        play_menu.add_command(label="Reload audio", command=self._reload_audio)
        menu.add_cascade(label="Playback", menu=play_menu)

        edit_menu = tk.Menu(menu, tearoff=False)
        edit_menu.add_command(label="Find", accelerator="Ctrl+F",
                              command=self._focus_search)
        edit_menu.add_command(label="Next match", accelerator="F3",
                              command=lambda: self._jump_match(1))
        edit_menu.add_command(label="Previous match",
                              accelerator="Shift+F3",
                              command=lambda: self._jump_match(-1))
        edit_menu.add_separator()
        edit_menu.add_command(label="Clear search", command=self._clear_search)
        menu.add_cascade(label="Edit", menu=edit_menu)

        view_menu = tk.Menu(menu, tearoff=False)
        view_menu.add_command(label="Dark mode", command=self._toggle_theme)
        view_menu.add_command(label="Show log", command=self._toggle_log)
        menu.add_cascade(label="View", menu=view_menu)

        help_menu = tk.Menu(menu, tearoff=False)
        help_menu.add_command(label="Install audio backend (pygame)...",
                              command=self._install_backend_prompt)
        help_menu.add_separator()
        help_menu.add_command(label="About", command=self._show_about)
        menu.add_cascade(label="Help", menu=help_menu)

        self.root.config(menu=menu)

    def _build_toolbar(self):
        bar = ttk.Frame(self.root)
        bar.grid(row=0, column=0, sticky="ew")

        self.btn_audio = ttk.Button(bar, text="\U0001F4C2 Open audio",
                                    command=self._open_audio)
        self.btn_audio.pack(side=tk.LEFT, padx=4, pady=4)
        self.btn_text = ttk.Button(bar, text="\U0001F4C4 Open transcript",
                                   command=self._open_transcript)
        self.btn_text.pack(side=tk.LEFT, padx=4, pady=4)
        self.btn_play = ttk.Button(bar, text="\u25B6 Play",
                                   command=self._toggle_play, state=tk.DISABLED)
        self.btn_play.pack(side=tk.LEFT, padx=4, pady=4)
        self.btn_stop = ttk.Button(bar, text="\u25A0 Stop",
                                   command=self._stop, state=tk.DISABLED)
        self.btn_stop.pack(side=tk.LEFT, padx=4, pady=4)
        self.btn_save = ttk.Button(bar, text="\U0001F4BE Save transcript",
                                   command=self._save_transcript, state=tk.DISABLED)
        self.btn_save.pack(side=tk.LEFT, padx=4, pady=4)
        self.btn_theme = ttk.Button(bar, text="\U0001F311 Dark mode",
                                    command=self._toggle_theme)
        self.btn_theme.pack(side=tk.LEFT, padx=4, pady=4)

        ttk.Label(bar, text="  Volume:").pack(side=tk.LEFT, padx=(16, 2), pady=4)
        self.volume_scale = tk.Scale(bar, from_=0, to=100, orient=tk.HORIZONTAL,
                                     length=110, command=self._on_volume)
        self.volume_scale.set(100)
        self.volume_scale.pack(side=tk.LEFT, padx=2, pady=4)

        self.btn_install = ttk.Button(bar, text="Install audio backend",
                                      command=self._install_backend_prompt)
        # shown only when no backend is available
        if self.player.available():
            self.btn_install.pack_forget()
        else:
            self.btn_install.pack(side=tk.RIGHT, padx=4, pady=4)

    def _build_text_area(self):
        container = ttk.Frame(self.root)
        container.grid(row=1, column=0, sticky="nsew")
        container.columnconfigure(0, weight=1)
        container.rowconfigure(0, weight=1)

        self.text = tk.Text(container, wrap=tk.WORD, font=DEFAULT_FONT,
                            padx=10, pady=8, spacing2=2, undo=True)
        self.text.grid(row=0, column=0, sticky="nsew")

        scroll = ttk.Scrollbar(container, command=self.text.yview)
        scroll.grid(row=0, column=1, sticky="ns")
        self.text.configure(yscrollcommand=scroll.set)

        self.text.tag_configure("current", background="#fff37c", foreground="#1a1a1a")
        self.text.tag_configure("match", background="#ffd966", foreground="#1a1a1a")

        self.text.bind("<Control-Button-1>", self._on_ctrl_click)
        self.text.bind("<Double-Button-1>", self._on_double_click)
        self.text.bind("<Button-3>", self._on_context_menu)
        self.text.bind("<Control-c>", self._on_copy)

    def _build_controls(self):
        frame = ttk.Frame(self.root)
        frame.grid(row=2, column=0, sticky="ew")
        frame.columnconfigure(2, weight=1)

        ttk.Label(frame, text="Time:").grid(row=0, column=0, padx=6, pady=4)
        self.time_var = tk.StringVar(value="00:00.00 / 00:00.00")
        self.time_label = ttk.Label(frame, textvariable=self.time_var, anchor="w")
        self.time_label.grid(row=0, column=1, padx=4, pady=4, sticky="w")

        self.seek_scale = tk.Scale(frame, from_=0, to=1000, orient=tk.HORIZONTAL,
                                   showvalue=False)
        self.seek_scale.grid(row=0, column=2, padx=6, pady=4, sticky="ew")
        self.seek_scale.bind("<B1-Motion>", self._on_seek_drag)
        self.seek_scale.bind("<ButtonRelease-1>", self._on_seek_release)

        ttk.Label(frame, text="Go to (mm:ss):").grid(row=0, column=3, padx=(14, 2), pady=4)
        self.jump_entry = ttk.Entry(frame, width=9)
        self.jump_entry.grid(row=0, column=4, padx=2, pady=4)
        self.jump_entry.bind("<Return>", lambda e: self._jump_to_time())
        ttk.Button(frame, text="Go", width=5, command=self._jump_to_time).grid(
            row=0, column=5, padx=4, pady=4)

        search_frame = ttk.Frame(frame)
        search_frame.grid(row=0, column=6, padx=(14, 6), pady=4, sticky="e")
        self.search_var = tk.StringVar()
        self.search_entry = ttk.Entry(search_frame, textvariable=self.search_var, width=18)
